{
    "label" : "lock",
    "action" : "hyprctl dispatch 'hl.dsp.exec_cmd([[$HOME/.config/hypr/scripts/lock.sh]])'",
    "text" : "Sperren",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "hyprctl dispatch 'hl.dsp.exit()'",
    "text" : "Abmelden",
    "keybind" : "e"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Ruhezustand",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Neustart",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Herunterfahren",
    "keybind" : "p"
}
